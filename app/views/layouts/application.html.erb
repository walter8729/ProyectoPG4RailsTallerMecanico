<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Taller Mecanico" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Taller Mecanico">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="sidebar">

  <button data-sidebar-target="opener" data-action="click->sidebar#toggle" type="button" class="hidden fixed top-3 left-3 z-50 text-blue-900 bg-white border border-blue-200 shadow-sm hover:bg-blue-50 rounded-lg p-2 focus:outline-none focus:ring-4 focus:ring-blue-200">
    <span class="sr-only">Abrir menú</span>
    <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
      <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
    </svg>
  </button>

  <aside data-sidebar-target="panel" class="fixed top-0 left-0 z-40 w-56 h-full transition-transform" aria-label="Sidebar">
    <div class="h-full px-3 py-4 overflow-y-auto bg-blue-900 border-e border-blue-800 flex flex-col">
      <div class="flex items-center justify-between mb-4 px-2">
        <%= link_to root_path, class: "flex items-center gap-2 text-white" do %>
          <svg class="w-6 h-6 text-sky-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l2.1-2.1a5 5 0 0 1-6.6 6.6L6.6 21.2a1.5 1.5 0 0 1-2.1-2.1L11.9 12A5 5 0 0 1 18.5 5.4l-2.1 2.1Z"/></svg>
          <span class="font-semibold">Taller Mecánico</span>
        <% end %>
        <button data-action="click->sidebar#toggle" type="button" class="text-blue-200 hover:text-white hover:bg-blue-800 rounded-lg p-1 focus:outline-none focus:ring-2 focus:ring-blue-600">
          <span class="sr-only">Colapsar menú</span>
          <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5 5-5m6 10-5-5 5-5"/></svg>
        </button>
      </div>

      <ul class="space-y-2 font-medium">
        <li>
          <%= link_to root_path, class: sidebar_link_classes(root_path) do %>
            <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
            <span class="ms-3">Home</span>
          <% end %>
        </li>
        <li>
          <%= link_to clientes_path, class: sidebar_link_classes(clientes_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M16 19h4a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-2m-2.236-4a3 3 0 1 0 0-4M3 18v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm8-10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Clientes</span>
          <% end %>
        </li>
        <li>
          <%= link_to cars_path, class: sidebar_link_classes(cars_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M16 19h4a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-2m-2.236-4a3 3 0 1 0 0-4M3 18v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm8-10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Autos</span>
          <% end %>
        </li>
        <li>
          <span class="flex items-center px-2 py-1.5 rounded-lg text-blue-300/60 cursor-not-allowed">
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10V6a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3v4m3-2 .917 11.923A1 1 0 0 1 17.92 21H6.08a1 1 0 0 1-.997-1.077L6 8h12Z"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Products</span>
            <span class="text-xs border border-blue-700 text-blue-300 rounded-sm px-1.5 py-0.5">Pronto</span>
          </span>
        </li>
      </ul>
    </div>
  </aside>

  <main data-sidebar-target="content" class="contenido ml-56">
      <%= yield %>
    </main>
  </body>
</html>
