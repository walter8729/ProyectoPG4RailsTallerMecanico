<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Taller Mecanico" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Taller Mecanico">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="sidebar">

  <button data-sidebar-target="opener" data-action="click->sidebar#toggle" type="button" class="hidden fixed top-3 left-3 z-50 text-blue-900 bg-white border border-blue-200 shadow-sm hover:bg-blue-50 rounded-lg p-2 focus:outline-none focus:ring-4 focus:ring-blue-200">
    <span class="sr-only">Abrir menú</span>
    <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
      <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
    </svg>
  </button>

  <aside data-sidebar-target="panel" class="fixed top-0 left-0 z-40 w-56 h-full transition-transform" aria-label="Sidebar">
    <div class="h-full px-3 py-4 overflow-y-auto bg-blue-900 border-e border-blue-800 flex flex-col">
      <div class="flex items-center justify-between mb-4 px-2">
        <%= link_to root_path, class: "flex items-center gap-2 text-white" do %>
          <svg class="w-6 h-6 text-sky-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l2.1-2.1a5 5 0 0 1-6.6 6.6L6.6 21.2a1.5 1.5 0 0 1-2.1-2.1L11.9 12A5 5 0 0 1 18.5 5.4l-2.1 2.1Z"/></svg>
          <span class="font-semibold">Taller Mecánico</span>
        <% end %>
        <button data-action="click->sidebar#toggle" type="button" class="text-blue-200 hover:text-white hover:bg-blue-800 rounded-lg p-1 focus:outline-none focus:ring-2 focus:ring-blue-600">
          <span class="sr-only">Colapsar menú</span>
          <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5 5-5m6 10-5-5 5-5"/></svg>
        </button>
      </div>

      <ul class="space-y-2 font-medium">
        <li>
          <%= link_to root_path, class: sidebar_link_classes(root_path) do %>
            <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
            <span class="ms-3">Home</span>
          <% end %>
        </li>
        <li>
          <%= link_to clientes_path, class: sidebar_link_classes(clientes_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M16 19h4a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-2m-2.236-4a3 3 0 1 0 0-4M3 18v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm8-10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Clientes</span>
          <% end %>
        </li>
        <li>
          <%= link_to cars_path, class: sidebar_link_classes(cars_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.9 2 11.2 2 11.5V16c0 .6.4 1 1 1h2m14 0a2 2 0 1 1-4 0m4 0a2 2 0 1 0-4 0m-10 0a2 2 0 1 1-4 0m4 0a2 2 0 1 0-4 0"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Autos</span>
          <% end %>
        </li>
        <li>
          <%= link_to orders_path, class: sidebar_link_classes(orders_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 9 2 2 4-4"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Órdenes</span>
          <% end %>
        </li>
        <li>
          <%= link_to services_path, class: sidebar_link_classes(services_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 9h6m-6 3h6m-6 3h6M6.996 9h.01m-.01 3h.01m-.01 3h.01M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Servicios</span>
          <% end %>
        </li>
        <li>
          <%= link_to mechanics_path, class: sidebar_link_classes(mechanics_path) do %>
            <svg class="shrink-0 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l2.1-2.1a5 5 0 0 1-6.6 6.6L6.6 21.2a1.5 1.5 0 0 1-2.1-2.1L11.9 12A5 5 0 0 1 18.5 5.4l-2.1 2.1Z"/></svg>
            <span class="flex-1 ms-3 whitespace-nowrap">Mecánicos</span>
          <% end %>
        </li>
      </ul>
    </div>
  </aside>

  <main data-sidebar-target="content" class="contenido ml-56">
    <% if notice.present? %>
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 500; font-size: 0.95rem;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg style="width: 20px; height: 20px; color: #059669; flex-shrink: 0;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span><%= notice %></span>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 500; font-size: 0.95rem;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg style="width: 20px; height: 20px; color: #dc2626; flex-shrink: 0;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span><%= alert %></span>
        </div>
      </div>
    <% end %>

    <%= yield %>
  </main>
  </body>
</html>
