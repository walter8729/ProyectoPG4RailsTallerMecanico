<%= render "shared/page_header",
           title: "Autos",
           button_text: "Agregar auto",
           button_url: new_car_path %>

<%= form_with url: cars_path, method: :get, local: true, class: "barra-busqueda" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "Buscar por placa, chasis, marca, modelo o cliente" %>
  <%= form.submit "Buscar", class: "btn" %>
  <% if params[:q].present? %>
    <%= link_to "Ver todos", cars_path, class: "link-limpiar" %>
  <% end %>
<% end %>

<div class="tabla-wrap">
  <table class="tabla">
    <thead>
      <tr>
        <th>Placa</th>
        <th>Vehículo</th>
        <th>Chasis (VIN)</th>
        <th>Kilometraje</th>
        <th>Cliente Propietario</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cars.each do |car| %>
        <tr>
          <td><span style="background: #fef3c7; color: #92400e; padding: 3px 8px; border-radius: 4px; font-weight: 700; font-size: 0.85rem;"><%= car.plate %></span></td>
          <td>
            <strong><%= car.brand %> <%= car.model %> (<%= car.year %>)</strong>
            <% if car.color.present? %>
              <div style="font-size: 0.8rem; color: #6b7280;">Color: <%= car.color %></div>
            <% end %>
          </td>
          <td><code style="font-size: 0.8rem; background: #f3f4f6; padding: 2px 4px; border-radius: 4px;"><%= car.chassis %></code></td>
          <td><%= number_with_delimiter(car.mileage) %> km</td>
          <td><%= car.customer&.full_name %></td>
          <td>
            <div class="tabla-acciones">
              <%= link_to icon_order_add, new_order_path(car_id: car.id), class: "btn-accion btn-accion-orden", title: "Crear nueva orden para este vehículo" %>
              <%= link_to icon_pencil, edit_car_path(car), class: "btn-accion btn-accion-editar", title: "Editar auto" %>
              <%= button_to icon_trash, car_path(car),
                            method: :delete,
                            class: "btn-accion btn-accion-borrar",
                            title: "Borrar auto",
                            form: { onsubmit: "return confirm('¿Borrar este auto?')" } %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @cars.empty? %>
        <tr>
          <td colspan="6" style="text-align: center; color: #6b7280; padding: 24px;">
            No se encontraron autos registrados.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== @pagy.series_nav if @pagy.pages > 1 %>


