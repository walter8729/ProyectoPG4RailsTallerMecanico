<%= form_with model: order, local: true, class: "form-card", style: "max-width: 720px;" do |form| %>
  <% if order.errors.any? %>
    <div style="background: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 16px;">
      <h3 style="margin: 0 0 8px 0; font-size: 0.95rem; font-weight: 600;">Se encontraron errores:</h3>
      <ul style="margin: 0; padding-left: 20px;">
        <% order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Buscador y selector de Vehículo con Datalist nativo -->
  <div style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <label for="car_search_input" style="font-weight: 600; font-size: 0.9rem; color: #1e3a8a; margin: 0;">
        Vehículo del Cliente *
      </label>
      <%= link_to "Ver lista completa de autos →", cars_path, style: "font-size: 0.8rem; color: #1e3a8a; text-decoration: underline;" %>
    </div>

    <% 
      # Buscar el auto actualmente seleccionado si existe
      current_car = @cars.find { |c| c.id == order.car_id }
      current_val = if current_car
        cliente_doc = current_car.customer ? " - Doc: #{current_car.customer.document_number}" : ""
        "#{current_car.plate} - #{current_car.brand} #{current_car.model} (#{current_car.customer&.full_name}#{cliente_doc}) [ID: #{current_car.id}]"
      else
        ""
      end
    %>

    <!-- Campo oculto real que viaja en el POST de Rails con el ID -->
    <%= form.hidden_field :car_id, id: "order_car_id_real", required: true %>

    <!-- Input interactivo con Datalist nativo de HTML5 -->
    <div style="position: relative;">
      <input type="text"
             id="car_search_input"
             list="cars_datalist"
             autocomplete="off"
             placeholder="Escribí para buscar: placa, marca, modelo, CI, RUC o cliente..."
             value="<%= current_val %>"
             oninput="actualizarIdAutoSeleccionado(this.value)"
             class="<%= 'field-invalid' if order.errors[:car_id].any? %>"
             style="width: 100%; height: 44px; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; background-color: #fff; font: inherit; color: #111827;">

      <datalist id="cars_datalist">
        <% @cars.each do |car| %>
          <% cliente_doc = car.customer ? " - Doc: #{car.customer.document_number}" : "" %>
          <% option_value = "#{car.plate} - #{car.brand} #{car.model} (#{car.customer&.full_name}#{cliente_doc}) [ID: #{car.id}]" %>
          <option value="<%= option_value %>"></option>
        <% end %>
      </datalist>
    </div>

    <div id="car_selected_feedback" style="margin-top: 6px; font-size: 0.8rem; color: #059669; font-weight: 500; min-height: 18px;">
      <% if current_car %>
        ✓ Vehículo seleccionado: <%= current_car.plate %> (<%= current_car.brand %> <%= current_car.model %>)
      <% else %>
        <span style="color: #6b7280;">Escribí cualquier letra o hacé doble clic para desplegar todos los autos.</span>
      <% end %>
    </div>
  </div>

  <script>
    function actualizarIdAutoSeleccionado(texto) {
      var match = texto.match(/\[ID:\s*(\d+)\]/i);
      var hiddenInput = document.getElementById("order_car_id_real");
      var feedback = document.getElementById("car_selected_feedback");

      if (match && match[1]) {
        hiddenInput.value = match[1];
        if (feedback) {
          feedback.innerHTML = "<span style='color: #059669;'>✓ Vehículo seleccionado (ID: " + match[1] + ")</span>";
        }
      } else {
        hiddenInput.value = "";
        if (feedback) {
          if (texto.trim() === "") {
            feedback.innerHTML = "<span style='color: #6b7280;'>Escribí cualquier letra o hacé doble clic para desplegar todos los autos.</span>";
          } else {
            feedback.innerHTML = "<span style='color: #d97706;'>⚠ Seleccioná una de las opciones sugeridas de la lista para confirmar el vehículo.</span>";
          }
        }
      }
    }
  </script>

  <div class="form-fila">
    <%= form.label :order_date, "Fecha Ingreso *" %>
    <%= form.date_field :order_date, required: true, value: (order.order_date || Date.current) %>
  </div>

  <div class="form-fila">
    <%= form.label :delivery_date, "Fecha Entrega" %>
    <%= form.date_field :delivery_date, placeholder: "Estimada o final" %>
  </div>

  <div class="form-fila">
    <%= form.label :status, "Estado *" %>
    <%= form.select :status, Order::STATUSES, {}, required: true %>
  </div>

  <div class="form-fila">
    <%= form.label :notes, "Observaciones" %>
    <%= form.text_area :notes, rows: 3, placeholder: "Falla reportada por el cliente, diagnóstico preliminar...", style: "width: 100%; border: 1px solid #d1d5db; border-radius: 8px; padding: 8px;" %>
  </div>

  <!-- Mecánicos asignados -->
  <div style="margin: 20px 0; padding-top: 16px; border-top: 1px solid #e5e7eb;">
    <h3 style="font-size: 1.1rem; font-weight: 600; color: #1e3a8a; margin-bottom: 12px;">Mecánicos Asignados</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px;">
      <% @mechanics.each do |mechanic| %>
        <label style="display: flex; align-items: center; gap: 8px; background: #f9fafb; padding: 8px 12px; border-radius: 6px; border: 1px solid #e5e7eb; cursor: pointer;">
          <%= check_box_tag "mechanic_ids[]", mechanic.id, order.mechanic_ids.include?(mechanic.id), id: "mechanic_#{mechanic.id}" %>
          <span style="font-size: 0.9rem;"><strong><%= mechanic.full_name %></strong> <small style="color: #6b7280;">(<%= mechanic.specialty %>)</small></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="form-acciones">
    <%= link_to "Cancelar", orders_path, class: "btn btn-secundario" %>
    <%= form.submit order.persisted? ? "Guardar Cambios" : "Continuar a Servicios", class: "btn" %>
  </div>
<% end %>
