<%= render "shared/page_header",
      title: "Órdenes de Trabajo",
      button_text: "Nueva orden de trabajo",
      button_url: new_order_path %>

<div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 20px;">
  <%= form_with url: orders_path, method: :get, local: true, class: "barra-busqueda", style: "margin-bottom: 0; flex: 1;" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Buscar por placa, chasis, cliente u observaciones" %>
    <% if params[:status].present? %>
      <%= form.hidden_field :status, value: params[:status] %>
    <% end %>
    <%= form.submit "Buscar", class: "btn" %>
    <% if params[:q].present? || params[:status].present? %>
      <%= link_to "Limpiar filtros", orders_path, class: "link-limpiar" %>
    <% end %>
  <% end %>
</div>

<div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 24px;">
  <span style="font-size: 0.85rem; font-weight: 600; color: #374151; white-space: nowrap;">Filtrar por estado:</span>
  <%= link_to "Todas", orders_path(q: params[:q]), class: "btn #{'btn-secundario' if params[:status].present?}" %>
  <%= link_to "Pendientes", orders_path(status: "Pendiente", q: params[:q]), class: "btn #{'btn-secundario' unless params[:status] == 'Pendiente'}" %>
  <%= link_to "En Proceso", orders_path(status: "En Proceso", q: params[:q]), class: "btn #{'btn-secundario' unless params[:status] == 'En Proceso'}" %>
  <%= link_to "Completadas", orders_path(status: "Completada", q: params[:q]), class: "btn #{'btn-secundario' unless params[:status] == 'Completada'}" %>
</div>

<div class="tabla-wrap">
  <table class="tabla">
    <thead>
      <tr>
        <th>Nro. Orden</th>
        <th>Fecha Ingreso</th>
        <th>Vehículo / Cliente</th>
        <th>Estado</th>
        <th>Mecánicos</th>
        <th>Total (PYG)</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><strong>#<%= order.id %></strong></td>
          <td><%= order.order_date.strftime("%d/%m/%Y") if order.order_date %></td>
          <td>
            <strong><%= order.car.plate %></strong> - <%= order.car.brand %> <%= order.car.model %>
            <div style="font-size: 0.85rem; color: #4b5563;">Propietario: <%= order.customer&.full_name %></div>
          </td>
          <td><%= order_status_badge(order.status) %></td>
          <td>
            <% if order.mechanics.any? %>
              <%= order.mechanics.map(&:full_name).join(", ") %>
            <% else %>
              <span style="color: #9ca3af; font-style: italic;">Sin asignar</span>
            <% end %>
          </td>
          <td><strong>₲ <%= number_with_delimiter(order.total) %></strong></td>
          <td>
            <div class="tabla-acciones">
              <%= link_to icon_eye, order_path(order), class: "btn-accion btn-accion-ver", title: "Ver detalle de la orden" %>
              <%= link_to icon_pencil, edit_order_path(order), class: "btn-accion btn-accion-editar", title: "Editar orden" %>
              <%= button_to icon_trash, order_path(order),
                    method: :delete,
                    class: "btn-accion btn-accion-borrar",
                    title: "Borrar orden",
                    form: { onsubmit: "return confirm('¿Desea borrar esta orden?')" } %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @orders.empty? %>
        <tr>
          <td colspan="7" style="text-align: center; color: #6b7280; padding: 28px;">
            No se encontraron órdenes de trabajo registradas con los criterios seleccionados.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== @pagy.series_nav if @pagy.pages > 1 %>
