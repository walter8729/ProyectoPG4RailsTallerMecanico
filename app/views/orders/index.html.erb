<%= render "shared/page_header",
      title: "Órdenes de Trabajo",
      button_text: "Nueva orden de trabajo",
      button_url: new_order_path %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <%= form_with url: orders_path, method: :get, local: true, class: "flex items-center gap-2 m-0 flex-1 max-w-xl" do |form| %>
    <%= form.text_field :q,
          value: params[:q],
          placeholder: "Buscar por placa, chasis, cliente u observaciones",
          class: "h-10 px-3.5 flex-1 border border-gray-300 rounded-lg text-sm bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600" %>
    <% if params[:status].present? %>
      <%= form.hidden_field :status, value: params[:status] %>
    <% end %>
    <%= form.submit "Buscar", class: "h-10 px-4 bg-blue-900 hover:bg-blue-800 text-white font-medium text-sm rounded-lg cursor-pointer transition-colors shrink-0" %>
    <% if params[:q].present? || params[:status].present? %>
      <%= link_to "Limpiar filtros", orders_path, class: "text-xs text-blue-900 hover:underline whitespace-nowrap ml-1" %>
    <% end %>
  <% end %>

  <div class="flex items-center gap-2 flex-wrap">
    <%= link_to "Todas", orders_path(q: params[:q]),
          class: "h-10 px-3.5 inline-flex items-center justify-center text-sm font-medium rounded-lg transition-colors #{params[:status].blank? ? 'bg-blue-900 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" %>
    <%= link_to "Pendientes", orders_path(status: "Pendiente", q: params[:q]),
          class: "h-10 px-3.5 inline-flex items-center justify-center text-sm font-medium rounded-lg transition-colors #{params[:status] == 'Pendiente' ? 'bg-blue-900 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" %>
    <%= link_to "En Proceso", orders_path(status: "En Proceso", q: params[:q]),
          class: "h-10 px-3.5 inline-flex items-center justify-center text-sm font-medium rounded-lg transition-colors #{params[:status] == 'En Proceso' ? 'bg-blue-900 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" %>
    <%= link_to "Completadas", orders_path(status: "Completada", q: params[:q]),
          class: "h-10 px-3.5 inline-flex items-center justify-center text-sm font-medium rounded-lg transition-colors #{params[:status] == 'Completada' ? 'bg-blue-900 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}" %>
  </div>
</div>

<div class="tabla-wrap">
  <table class="tabla">
    <thead>
      <tr>
        <th>Nro. Orden</th>
        <th>Fecha Ingreso</th>
        <th>Vehículo / Cliente</th>
        <th>Estado</th>
        <th>Mecánicos</th>
        <th>Total (PYG)</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><strong>#<%= order.id %></strong></td>
          <td><%= order.order_date.strftime("%d/%m/%Y") if order.order_date %></td>
          <td>
            <strong><%= order.car.plate %></strong> - <%= order.car.brand %> <%= order.car.model %>
            <div style="font-size: 0.85rem; color: #4b5563;">Propietario: <%= order.customer&.full_name %></div>
          </td>
          <td><%= order_status_badge(order.status) %></td>
          <td>
            <% if order.mechanics.any? %>
              <%= order.mechanics.map(&:full_name).join(", ") %>
            <% else %>
              <span style="color: #9ca3af; font-style: italic;">Sin asignar</span>
            <% end %>
          </td>
          <td><strong>₲ <%= number_with_delimiter(order.total) %></strong></td>
          <td class="tabla-acciones">
            <%= link_to "Ver Detalle", order_path(order), class: "tabla-link", style: "font-weight: 600;" %>
            <%= link_to "Editar", edit_order_path(order), class: "tabla-link" %>
            <%= button_to "Borrar", order_path(order),
                  method: :delete,
                  class: "tabla-link tabla-link-borrar",
                  form: { onsubmit: "return confirm('¿Desea borrar esta orden?')" } %>
          </td>
        </tr>
      <% end %>
      <% if @orders.empty? %>
        <tr>
          <td colspan="7" style="text-align: center; color: #6b7280; padding: 28px;">
            No se encontraron órdenes de trabajo registradas con los criterios seleccionados.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== @pagy.series_nav if @pagy.pages > 1 %>
