<%= form_with model: service, local: true, class: "form-card" do |form| %>
  <% if service.errors.any? %>
    <div style="background: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 16px;">
      <h3 style="margin: 0 0 8px 0; font-size: 0.95rem; font-weight: 600;">Se encontraron errores:</h3>
      <ul style="margin: 0; padding-left: 20px;">
        <% service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-fila">
    <%= form.label :name, "Nombre *" %>
    <%= form.text_field :name, required: true, placeholder: "ej. Cambio de Aceite y Filtro", class: ("field-invalid" if service.errors[:name].any?) %>
  </div>

  <div class="form-fila">
    <%= form.label :description, "Descripción" %>
    <%= form.text_field :description, placeholder: "Breve detalle del servicio (opcional)" %>
  </div>

  <div class="form-fila">
    <%= form.label :price, "Precio (PYG) *" %>
    <%= form.number_field :price, required: true, min: 0, step: 1, placeholder: "ej. 150000", class: ("field-invalid" if service.errors[:price].any?) %>
  </div>

  <div class="form-acciones">
    <%= link_to "Cancelar", services_path, class: "btn btn-secundario" %>
    <%= form.submit service.persisted? ? "Guardar Cambios" : "Crear Servicio", class: "btn" %>
  </div>
<% end %>
