<%= form_with model: mechanic, local: true, class: "form-card" do |form| %>
  <% if mechanic.errors.any? %>
    <div style="background: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 16px;">
      <h3 style="margin: 0 0 8px 0; font-size: 0.95rem; font-weight: 600;">Se encontraron errores:</h3>
      <ul style="margin: 0; padding-left: 20px;">
        <% mechanic.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-fila">
    <%= form.label :first_name, "Nombre *" %>
    <%= form.text_field :first_name, required: true, placeholder: "ej. Carlos", class: ("field-invalid" if mechanic.errors[:first_name].any?) %>
  </div>

  <div class="form-fila">
    <%= form.label :last_name, "Apellido *" %>
    <%= form.text_field :last_name, required: true, placeholder: "ej. Gómez", class: ("field-invalid" if mechanic.errors[:last_name].any?) %>
  </div>

  <div class="form-fila">
    <%= form.label :specialty, "Especialidad *" %>
    <%= form.text_field :specialty, required: true, placeholder: "ej. Mecánica General, Electricidad, Frenos", class: ("field-invalid" if mechanic.errors[:specialty].any?) %>
  </div>

  <div class="form-fila">
    <%= form.label :phone, "Teléfono *" %>
    <%= form.telephone_field :phone, required: true, placeholder: "ej. 0981 123 456", class: ("field-invalid" if mechanic.errors[:phone].any?) %>
  </div>

  <div class="form-acciones">
    <%= link_to "Cancelar", mechanics_path, class: "btn btn-secundario" %>
    <%= form.submit mechanic.persisted? ? "Guardar Cambios" : "Crear Mecánico", class: "btn" %>
  </div>
<% end %>
