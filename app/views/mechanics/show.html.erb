<%= render "shared/page_header",
      title: @mechanic.full_name,
      button_text: "Editar Mecánico",
      button_url: edit_mechanic_path(@mechanic) %>

<div class="detalle-grid">

  <!-- Tarjeta Datos del Mecánico -->
  <div class="form-card" style="max-width: 100%;">
    <h3 class="card-titulo">Datos del Mecánico</h3>
    <p class="dato-fila"><strong>Nombre completo:</strong> <%= @mechanic.full_name %></p>
    <p class="dato-fila">
      <strong>Especialidad:</strong>
      <span class="badge-doc">
        <%= @mechanic.specialty %>
      </span>
    </p>
    <p class="dato-fila"><strong>Teléfono:</strong> <%= @mechanic.phone %></p>
  </div>

  <!-- Tarjeta Resumen de Órdenes -->
  <div class="form-card" style="max-width: 100%;">
    <h3 class="card-titulo">Resumen de Actividad</h3>
    <p class="dato-fila"><strong>Total de órdenes asignadas:</strong> <%= @mechanic.orders.size %></p>
    <% pendientes = @mechanic.orders.count { |o| o.status == "Pendiente" } %>
    <% en_proceso = @mechanic.orders.count { |o| o.status == "En Proceso" } %>
    <% completadas = @mechanic.orders.count { |o| o.status == "Completada" } %>
    <p class="dato-fila"><strong>Pendientes:</strong> <%= pendientes %></p>
    <p class="dato-fila"><strong>En Proceso:</strong> <%= en_proceso %></p>
    <p class="dato-fila"><strong>Completadas:</strong> <%= completadas %></p>
  </div>
</div>

<!-- Órdenes asignadas -->
<%= render "mechanics/orders", mechanic: @mechanic %>

<div class="detalle-acciones">
  <%= link_to "Volver a Mecánicos", mechanics_path, class: "btn btn-secundario" %>
</div>
