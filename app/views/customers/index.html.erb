<%= render "shared/page_header",
      title: "Clientes",
      button_text: "Agregar cliente",
      button_url: new_cliente_path %>



<%= form_with url: clientes_path, method: :get, local: true, class: "barra-busqueda" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nombre, apellido, documento o teléfono" %>
  <%= form.submit "Buscar", class: "btn" %>
  <% if params[:q].present? %>
    <%= link_to "Ver todos", clientes_path, class: "link-limpiar" %>
  <% end %>
<% end %>


<div class="tabla-wrap">
  <table class="tabla">
    <thead>
      <tr>
        <th>Documento</th>
        <th>Nombre y Apellido</th>
        <th>Teléfono</th>
        <th>Email</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td><span style="background: #f3f4f6; color: #374151; padding: 3px 7px; border-radius: 4px; font-size: 0.825rem; font-weight: 600;"><%= customer.document_type %>: <%= customer.document_number %></span></td>
          <td><strong><%= customer.full_name %></strong></td>
          <td><%= customer.phone %></td>
          <td><%= customer.email.presence || "-" %></td>
          <td>
            <div class="tabla-acciones">
              <%= link_to icon_pencil, edit_cliente_path(customer), class: "btn-accion btn-accion-editar", title: "Editar cliente" %>
              <%= button_to icon_trash, cliente_path(customer),
                    method: :delete,
                    class: "btn-accion btn-accion-borrar",
                    title: "Borrar cliente",
                    form: { onsubmit: "return confirm('¿Borrar este cliente?')" } %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @customers.empty? %>
        <tr>
          <td colspan="5" style="text-align: center; color: #6b7280; padding: 24px;">
            No se encontraron clientes registrados.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== @pagy.series_nav if @pagy.pages > 1 %>
