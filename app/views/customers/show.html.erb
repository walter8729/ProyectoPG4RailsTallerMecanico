<%= render "shared/page_header",
      title: "#{@customer.full_name}",
      button_text: "Editar Cliente",
      button_url: edit_cliente_path(@customer) %>

<div class="detalle-grid">

  <!-- Tarjeta Datos del Cliente -->
  <div class="form-card" style="max-width: 100%;">
    <h3 class="card-titulo">Datos del Cliente</h3>

    <p class="dato-fila">
      <strong>Documento:</strong>
      <span class="badge-doc">
        <%= @customer.document_type %>: <%= @customer.document_number %>
      </span>
    </p>
    <p class="dato-fila"><strong>Nombre completo:</strong> <%= @customer.full_name %></p>
    <p class="dato-fila"><strong>Teléfono:</strong> <%= @customer.phone %></p>
    <% if @customer.email.present? %>
      <p class="dato-fila"><strong>Email:</strong> <%= @customer.email %></p>
    <% end %>
    <% if @customer.address.present? %>
      <p class="dato-fila"><strong>Dirección:</strong> <%= @customer.address %></p>
    <% end %>
  </div>

  <!-- Tarjeta Resumen -->
  <div class="form-card" style="max-width: 100%;">
    <h3 class="card-titulo">Resumen</h3>
    <p class="dato-fila"><strong>Autos registrados:</strong> <%= @customer.cars.count %></p>
    <p class="dato-fila"><strong>Órdenes de trabajo:</strong>
      <% total_orders = @customer.cars.joins(:orders).count rescue 0 %>
      <%= total_orders %>
    </p>
  </div>
</div>

<!-- Autos del cliente -->
<%= render "customers/cars", customer: @customer %>

<div class="detalle-acciones">
  <%= link_to "Volver a Clientes", clientes_path, class: "btn btn-secundario" %>
  <%= button_to "Eliminar Cliente", cliente_path(@customer),
        method: :delete,
        class: "btn btn-peligro",
        form: { onsubmit: "return confirm('¿Eliminar este cliente y todos sus datos?')" } %>
</div>
